{
  "env": {
    "node": true,
    "es2021": true
  },
  "extends": "eslint:recommended",
  "ignorePatterns": [
    "node_modules/",
    "studio/",
    "public/",
    "coverage/"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "overrides": [
    {
      "files": ["__tests__/**/*.js"],
      "env": { "jest": true }
    },
    {
      "files": ["worker*.js"],
      "env": { "worker": true }
    }
  ],
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-console": "off"
  }
}
